---
import { features } from '../../config/features';

// GATED ROUTE. A rest parameter that generates exactly one path, or none.
//
// This file used to be src/pages/news.astro. A page sitting in src/pages/ is routed
// whether or not the school has the feature, so turning `news` off removed
// every link to this page and left the page itself reachable by anyone with
// the URL. A school that does not run a news page would have shipped one.
//
// Returning [] from getStaticPaths emits nothing. Returning a single undefined
// path emits the parent route, which is the same URL this page always had.
export function getStaticPaths() {
  return features.news ? [{ params: { path: undefined } }] : [];
}

import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Six items that used to be an array of objects in this file, each with its
// own image import at the top. Adding a seventh meant editing a page.
const posts = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);

const thumbSizes = '(max-width: 820px) 92vw, 30vw';
---
<Layout
  title={`News & Events - ${site.name}`}
  description="TODO One sentence for search results, about the school's news and events."
  active="news"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">News &amp; Events</p>
    <h1>Life at {site.shortName}.</h1>
    <p>Celebrations, milestones and everyday moments from our school community.</p>
  </div>
</section>

<section class="news news-page">
  <div class="wrap">
    <div class="grid3">
      {posts.map((post) => (
        <article class="ncard">
          <div class="thumb">
            <Image src={post.data.cover} alt={post.data.coverAlt} widths={[400, 640, 900]} sizes={thumbSizes} format="webp" quality={72} loading="lazy" />
          </div>
          <div class="body">
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Stay close to the school</p>
    <h2>Want to be part of it?</h2>
    <p>TODO A closing line inviting a visit.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/admissions">Explore Admissions <span class="arr">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/contact">Contact Us</a>
    </div>
  </div>
</section>

</Layout>

---
import Icon from '../system/components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { site, tel, mapsUrlFor, addressLineFor, whatsappUrl } from '../config/site';
import Directions from '../system/blocks/Directions/Routes.astro';

// The WhatsApp line belongs to a campus, not to the school, so it is read off
// the campus rather than assumed. Only Campus 1 keeps one; if that changes the
// row disappears instead of rendering "undefined".
const whatsapp = site.campuses.find((campus) => campus.whatsapp)?.whatsapp;
---
<Layout
  title={`Contact - ${site.name}`}
  description="Addresses, phone numbers and office hours for all three Unifac Group of Schools campuses in Benin City."
  active="contact"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Contact Us</p>
    <h1>We’d love to hear from you.</h1>
    <p>Whether you’re enquiring about a place or arranging a visit, our door and our inbox are open. We teach across three campuses in Benin City, each with its own line.</p>
  </div>
</section>

<section>
  <div class="wrap contact-grid">
    <div>
      <p class="eyebrow">Reach the School</p>
      <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);margin:.5rem 0 1.4rem">Visit, call or email.</h2>
      <div class="cinfo">
        {whatsapp && (
          <div class="row">
            <div class="ic"><Icon name="mobile" size={22} stroke={1.7} /></div>
            <div>
              <h4>WhatsApp</h4>
              <a href={whatsappUrl(whatsapp)} target="_blank" rel="noopener">{whatsapp.display}</a>
            </div>
          </div>
        )}
        <div class="row">
          <div class="ic"><Icon name="mail" size={22} stroke={1.7} /></div>
          <div>
            <h4>Email</h4>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <div class="row">
          <div class="ic"><Icon name="clock" size={22} stroke={1.7} /></div>
          <div>
            <h4>Office Hours</h4>
            <p>{site.officeHours}</p>
          </div>
        </div>
      </div>
    </div>

    <div>
      <form class="cform" id="contactForm" data-mailto={site.email}>
        <p class="eyebrow" style="margin-bottom:.4rem">Send a Message</p>
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" placeholder="Jane Doe" required />
        <label for="cf-email">Email address</label>
        <input id="cf-email" name="email" type="email" placeholder="you@example.com" required />
        <label for="cf-phone">Phone (optional)</label>
        <input id="cf-phone" name="phone" type="tel" placeholder="0800 000 0000" />
        <label for="cf-message">How can we help?</label>
        <textarea id="cf-message" name="message" placeholder="Tell us about your child and what you’d like to know…" required></textarea>
        <button class="btn btn-gold" type="submit">Send Message <span class="arr">→</span></button>
      </form>

      <!--
        The form hands off to the visitor's mail app. That silently does nothing
        on a device with no mail client configured (common on desktop), and the
        visitor walks away believing the message was sent. This panel appears
        after the handoff so there is always a way through.
      -->
      <div class="cform cf-fallback" id="cfFallback" hidden>
        <h3>Did your mail app open?</h3>
        <p>If it did, just press send: your message is already written. If nothing happened, this device has no mail app set up. Copy your message below and send it from wherever you normally read email.</p>
        <label for="cf-copy">Your message</label>
        <textarea id="cf-copy" readonly></textarea>
        <div class="cf-actions">
          <button class="btn btn-brand" type="button" id="cfCopy">Copy message</button>
          <a class="btn btn-outline" href={tel(0)}>Call instead</a>
        </div>
        <p class="cf-addr">Send it to <strong>{site.email}</strong></p>
      </div>
    </div>
  </div>
</section>

<section class="surface-alt">
  <div class="wrap">
    <p class="eyebrow">Our Campuses</p>
    <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);margin:.5rem 0 0">Three sites across Benin City.</h2>
    <p class="lead-copy">Each campus keeps its own line. Call the one you are visiting.</p>

    <div class="grid3 campus-grid">
      {site.campuses.map((campus) => (
        <div class="vcard campus">
          <div class="ic"><Icon name="map-pin" size={24} stroke={1.7} /></div>
          <h3>{campus.name}</h3>
          <a class="campus-addr" href={mapsUrlFor(campus)} target="_blank" rel="noopener">
            {addressLineFor(campus)}
          </a>
          <p class="campus-line">
            <a href={`tel:${campus.phone.dial}`}>{campus.phone.display}</a>
          </p>
          {campus.whatsapp && (
            <p class="campus-line">
              <a href={whatsappUrl(campus.whatsapp)} target="_blank" rel="noopener">
                {campus.whatsapp.display} on WhatsApp
              </a>
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<Directions />

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Admissions Open</p>
    <h2>Ready to take the next step?</h2>
    <p>Applications for the 2026/2027 session are open across all stages.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/admissions">Explore Admissions <span class="arr">→</span></a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  // Read off the form rather than imported from config: this script is bundled
  // and shipped to the browser, and pulling in site.ts would send the whole
  // configuration, schema and all, to every visitor to save one string.
  const ADDRESS = form?.dataset.mailto ?? '';
  const fallback = document.getElementById('cfFallback');
  const copyArea = document.getElementById('cf-copy');
  const copyBtn = document.getElementById('cfCopy');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = (data.get('name') || '').toString();
      const email = (data.get('email') || '').toString();
      const phone = (data.get('phone') || '').toString();
      const message = (data.get('message') || '').toString();

      const plain = `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\n\n${message}`;
      const subject = encodeURIComponent(`Website enquiry from ${name}`);

      // Mail clients drop everything past roughly 2000 characters in a mailto,
      // so a long enquiry would arrive truncated with no warning. Past that,
      // hand over just the subject and let the copy panel carry the message.
      const encoded = encodeURIComponent(plain);
      const useBody = encoded.length < 1500;
      const href = useBody
        ? `mailto:${ADDRESS}?subject=${subject}&body=${encoded}`
        : `mailto:${ADDRESS}?subject=${subject}`;

      if (copyArea) copyArea.value = plain;
      window.location.href = href;

      // There is no way to detect whether the mail app opened, so always reveal
      // the fallback shortly after. On a device that did open one, the panel
      // simply confirms what happened.
      window.setTimeout(() => {
        if (fallback) {
          fallback.hidden = false;
          fallback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }, 900);
    });
  }

  if (copyBtn && copyArea) {
    copyBtn.addEventListener('click', async () => {
      const done = (ok) => {
        copyBtn.textContent = ok ? 'Copied ✓' : 'Press Ctrl+C to copy';
        window.setTimeout(() => { copyBtn.textContent = 'Copy message'; }, 2500);
      };
      try {
        await navigator.clipboard.writeText(copyArea.value);
        done(true);
      } catch {
        // Clipboard API needs a secure context and permission; selecting the
        // text is the reliable fallback on older Android browsers.
        copyArea.removeAttribute('readonly');
        copyArea.select();
        copyArea.setSelectionRange(0, copyArea.value.length);
        copyArea.setAttribute('readonly', '');
        done(false);
      }
    });
  }
</script>

<style>
  /*
   * The campus cards reuse .vcard, which is built for a heading and one
   * paragraph. A campus needs an address, a phone and sometimes a WhatsApp
   * line, so only the spacing between those is set here; everything else
   * (the border, the radius, the lift on hover) still comes from the system.
   */
  .campus-grid {
    margin-top: 2rem;
  }
  .campus h3 {
    margin: 0 0 0.5rem;
  }
  .campus-addr {
    display: block;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .campus-addr:hover {
    color: var(--brand);
  }
  .campus-line {
    margin: 0.6rem 0 0;
  }
  .campus-line a {
    color: var(--ink);
    font-weight: 700;
  }
  .campus-line a:hover {
    color: var(--brand);
  }
  @media (max-width: 900px) {
    .campus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

</Layout>

---
import { features } from '../../../config/features';

// GATED ROUTE. A rest parameter that generates exactly one path, or none.
//
// This file used to be src/pages/portal/staff.astro. A page sitting in src/pages/ is routed
// whether or not the school has the feature, so turning `portal` off removed
// every link to this page and left the page itself reachable by anyone with
// the URL. A school that does not run a portal would have shipped one.
//
// Returning [] from getStaticPaths emits nothing. Returning a single undefined
// path emits the parent route, which is the same URL this page always had.
export function getStaticPaths() {
  return features.portal ? [{ params: { path: undefined } }] : [];
}

import Icon from '../../../system/components/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../config/site';
import PortalCard from '../../../system/blocks/Cards/PortalCard.astro';
import { portalHref } from '../../../config/integrations';

/**
 * The staff door, reached from the chooser at /portal.
 *
 * A teacher's work is genuinely split across the two applications: lessons and
 * assignments are authored in JDSmartLearn, while marks, attendance and result
 * sheets live in ResultPeak. Rather than pick one and let half the staff learn
 * the wrong address, this page names both and says plainly which task lives
 * where. Administrators skip it; their door on /portal goes straight through.
 */
const staffLearn = portalHref('staffLearn');
const staffResultPeak = portalHref('staffResultPeak');
---
<Layout
  title={`Staff Portal - ${site.name}`}
  description="The staff door to the Unifac Group of Schools portal."
  active="portal"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/portal" class="crumb">Portal</a> / Staff</p>
    <h1>Teaching and marking.</h1>
    <p>Your work sits in two systems, and which one you want depends on the task. Both take the school email address and password issued to you, not a student access code.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">For Teachers and Tutors</p><h2>Which task are you here for?</h2><p>If you are unsure, the rule is simple: anything a child reads is in the first card, anything a child scores is in the second.</p></div>
    <div class="feat-grid two">

      <PortalCard
        title="Lessons &amp; assignments"
        href={staffLearn}
        app="staffLearn"
        action="Tutor sign in"
        meta="Draft, review, publish"
      >
        <Icon name="pencil" />
        Upload a lesson and get a student summary, practice questions and a marking guide back. Set assignments and see who has turned one in. Nothing reaches students until you have edited and published it.
      </PortalCard>

      <PortalCard
        title="Marks, attendance &amp; results"
        href={staffResultPeak}
        app="staffResultPeak"
        action="Staff sign in"
        meta="Tutors and school administrators"
      >
        <Icon name="dashboard" />
        Build exams, review AI-marked written answers before the score counts, take attendance, enter your continuous assessment marks and produce the term result sheets.
      </PortalCard>

    </div>
  </div>
</section>

<section style="background:var(--surface-2)">
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">Good to know</p><h2>How the two fit together.</h2></div>
    <div class="steps">
      <div class="step">
        <h3>One roster, two systems</h3>
        <p>Class lists and student records are held once and shared, so a child added to your class appears in both places. You never enter a roster twice.</p>
      </div>
      <div class="step">
        <h3>Your account carries your school</h3>
        <p>{site.shortName} is attached to your sign-in, so neither system asks you to pick a school. If either one does, you are on the wrong account; tell the office.</p>
      </div>
      <div class="step">
        <h3>Marks reach the sheet through you</h3>
        <p>AI assistance drafts a mark for a written answer; it does not award one. Nothing reaches a result sheet a parent sees until a teacher has looked at it.</p>
      </div>
    </div>
    <div class="cta" style="margin-top:2.4rem">
      <a class="btn btn-outline" href="/portal">Back to the portal</a>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">Administrators</p>
    <h2>Looking for the school dashboard?</h2>
    <p>Roster management, class lists, exam windows, released results and student access codes are on the administrator door.</p>
    <div class="cta">
      {staffResultPeak
        ? <a class="btn btn-gold btn-lg" href={staffResultPeak} rel="noopener">Administrator sign in <span class="arr">&rarr;</span></a>
        : <a class="btn btn-gold btn-lg" href="/contact">Contact the School <span class="arr">&rarr;</span></a>}
      <a class="btn btn-ghost btn-lg" href="/contact">Ask the office</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .crumb {
    color: var(--accent-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

---
import Icon from '../system/components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import MediaText from '../system/blocks/Media/Text.astro';
import FullBleed from '../system/blocks/Media/FullBleed.astro';
import Facilities from '../system/blocks/Feature/Grid.astro';
import { Image } from 'astro:assets';
import artsPhoto from '../assets/images/arts.jpg';
import curiosityPhoto from '../assets/images/science.jpg';
import communityPhoto from '../assets/images/community.jpg';
import welcomePhoto from '../assets/images/outdoors.jpg';
---
<Layout
  title={`School Life - ${site.name}`}
  description="TODO One sentence for search results, about life beyond the classroom."
  active="school-life"
>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">School Life</p>
    <h1>Learning that reaches beyond the classroom.</h1>
    <p>TODO Two sentences on what a school day feels like here outside lessons.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">A Full School Day</p><h2>Room to explore, belong and shine.</h2><p>We want children to leave each day a little more confident, a little more curious, and glad to come back tomorrow.</p></div>
    <div class="feat-grid">
      <div class="feat">
        <div class="ic"><Icon name="ball" /></div>
        <h3>Sport &amp; Play</h3>
        <p>Active, healthy days with games and physical education that build teamwork, resilience and joy in movement.</p>
      </div>
      <div class="feat">
        <div class="ic"><Icon name="music" /></div>
        <h3>Arts &amp; Music</h3>
        <p>Creative expression through music, drama and the visual arts, with space for every child to discover a talent.</p>
      </div>
      <div class="feat">
        <div class="ic"><Icon name="heart" /></div>
        <h3>Character &amp; Service</h3>
        <p>Honesty, kindness and courage, practised through everyday responsibility and care for one another.</p>
      </div>
      <div class="feat">
        <div class="ic"><Icon name="shield-check" /></div>
        <h3>Safe &amp; Nurturing</h3>
        <p>A secure, welcoming environment where pastoral care means every child is known, supported and valued.</p>
      </div>
      <div class="feat">
        <div class="ic"><Icon name="users" /></div>
        <h3>Community</h3>
        <p>A close partnership between pupils, parents and staff - celebrated together on Founder’s Day and beyond.</p>
      </div>
      <div class="feat">
        <div class="ic"><Icon name="eye" /></div>
        <h3>Curiosity &amp; Enquiry</h3>
        <p>Clubs, projects and real-world learning - like our science fair; that turn wondering into discovery.</p>
      </div>
    </div>
  </div>
</section>

<MediaText
  image={artsPhoto}
  alt="Pupils enjoying art and craft"
  eyebrow="Creativity"
  title="Arts, music and making."
  surface="alt"
>
  <p>From art and craft to music and drama, we give every child room to create, perform and discover a talent. Creative work builds confidence, focus and joy;and it belongs at the heart of a good education.</p>
</MediaText>

<FullBleed
  image={communityPhoto}
  alt="Pupils celebrating together"
  eyebrow="Our Community"
  title="A school that celebrates together."
>
  <p>TODO The events and traditions that make this school a community. Name real ones.</p>
</FullBleed>

<Facilities
  surface="alt"
  title="The spaces behind a full school day."
  intro="A music studio and instruments, sports facilities and playing grounds, an art and craft studio, and well equipped Biology, Chemistry, Physics and Computer laboratories: every interest has somewhere to grow."
/>

<MediaText
  image={curiosityPhoto}
  alt="Young scientists exploring a project"
  eyebrow="Curiosity in Action"
  title="Where wondering becomes discovery."
  reverse={true}
>
  <p>Clubs, hands-on projects and events like our science fair turn everyday curiosity into real learning. We want children to ask questions, test ideas, and delight in finding things out for themselves.</p>
</MediaText>

<section class="welcome">
  <div class="wrap">
    <div class="photo">
      <Image src={welcomePhoto} alt="Children at outdoor play" widths={[480, 768, 1100]} sizes="(max-width: 820px) 92vw, 46vw" format="webp" quality={74} loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Our Community</p>
      <h2>Every child known by name.</h2>
      <blockquote>“Character isn’t taught in a single lesson; it’s grown in a thousand small moments across a school day. That is the work we love most.”</blockquote>
      <div class="signoff">The {site.shortName} Team<small>TODO The school motto</small></div>
      <div class="cta" style="margin-top:1.6rem">
        <a class="btn btn-brand" href="/contact">Come and Visit <span class="arr">→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--accent-300)">See it for yourself</p>
    <h2>The best way to know {site.shortName} is to visit.</h2>
    <p>TODO A closing invitation to spend a morning at the school.</p>
    <div class="cta">
      <a class="btn btn-gold btn-lg" href="/contact">Arrange a Visit <span class="arr">→</span></a>
      <a class="btn btn-ghost btn-lg" href="/admissions">See Admissions</a>
    </div>
  </div>
</section>

</Layout>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Actions from '../Actions.astro';
import type { Action } from '../types';
import { site } from '../../../config/site';

export interface Slide {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  /**
   * The photographs, in order. Passed in rather than imported here, because a
   * component that hardcodes five filenames is a component that only works for
   * the school those five belong to. A school with three good pictures passes
   * three, and the dots and the timer follow.
   */
  slides: Slide[];
  /** Allows an <em> around the emphasised word, which is why it is set:html. */
  headline?: string;
  lead?: string;
  actions?: Action[];
}

const { slides, headline, lead, actions = [] } = Astro.props;
---
<section class="hero-carousel" aria-label={`Featured images of ${site.shortName}`}>
  <div class="hc-slides" aria-hidden="true">
    {slides.map((s, i) => (
      <div class={`hc-slide${i === 0 ? ' is-active' : ''}`}>
        <Image
          src={s.src}
          alt={s.alt}
          widths={[768, 1200, 1672]}
          sizes="100vw"
          format="webp"
          quality={82}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>
  <div class="hc-overlay" aria-hidden="true"></div>
  <div class="hc-content">
    {headline ? (
      <>
        <h1 set:html={headline} />
        {lead && <p class="lead">{lead}</p>}
        {actions.length > 0 && <Actions actions={actions} large />}
      </>
    ) : (
      <slot />
    )}
  </div>
  <div class="hc-dots" role="tablist" aria-label="Choose slide">
    {slides.map((_, i) => (
      <button
        type="button"
        class={`hc-dot${i === 0 ? ' is-active' : ''}`}
        role="tab"
        aria-label={`Show image ${i + 1} of ${slides.length}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-idx={i}
      ></button>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector('.hero-carousel');
  if (root) {
    const slides = Array.from(root.querySelectorAll('.hc-slide'));
    const dots = Array.from(root.querySelectorAll('.hc-dot'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DWELL = 6000;
    let i = 0;
    let timer = 0;

    function go(n: number) {
      slides[i]?.classList.remove('is-active');
      dots[i]?.classList.remove('is-active');
      dots[i]?.setAttribute('aria-selected', 'false');
      i = (n + slides.length) % slides.length;
      slides[i]?.classList.add('is-active');
      dots[i]?.classList.add('is-active');
      dots[i]?.setAttribute('aria-selected', 'true');
    }
    function next() { go(i + 1); }
    function start() { if (reduce) return; stop(); timer = window.setInterval(next, DWELL); }
    function stop() { if (timer) { clearInterval(timer); timer = 0; } }

    dots.forEach((d, idx) =>
      d.addEventListener('click', () => { go(idx); start(); })
    );
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    );
    start();
  }
</script>

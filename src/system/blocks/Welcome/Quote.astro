---
/**
 * A photograph beside a signed quotation. The head of school's welcome, in
 * practice, which is why the signature block is part of the block rather than
 * something each page assembles.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Action } from '../types';
import Actions from '../Actions.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  quote?: string;
  signature?: string;
  signatureRole?: string;
  actions?: Action[];
}

const { image, alt, eyebrow, title, quote, signature, signatureRole, actions = [] } = Astro.props;
---
<div class="wrap">
  <div class="photo">
    <Image src={image} alt={alt} widths={[480, 768, 1100]} sizes="(max-width: 820px) 92vw, 46vw" format="webp" quality={74} loading="lazy" />
  </div>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {quote && <blockquote>{quote}</blockquote>}
    {signature && <div class="signoff">{signature}<small>{signatureRole}</small></div>}
    {actions.length > 0 && <Actions actions={actions} style="margin-top:1.6rem" />}
  </div>
</div>

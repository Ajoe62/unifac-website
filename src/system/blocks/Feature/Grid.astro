---
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';
import type { Surface } from '../types';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  surface?: Surface;
  id?: string;
}

const {
  eyebrow = 'Our Facilities',
  title = 'Well-equipped spaces for real learning.',
  intro = 'Good teaching deserves good tools. Our laboratories, studios, library and grounds give pupils the space and equipment to learn by doing.',
  surface = 'base',
  id,
} = Astro.props;

// The six cards used to be written out here, icons and all. A school with a
// swimming pool and no music studio had to edit a component to say so.
const facilities = (await getCollection('facilities')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<section id={id} class={['facilities', surface !== 'base' ? `surface-${surface}` : null].filter(Boolean).join(' ')}>
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{intro}</p></div>
    <div class="feat-grid">
      {facilities.map((item) => (
        <div class="feat">
          <div class="ic"><Icon name={item.data.icon} /></div>
          <h3>{item.data.title}</h3>
          <p>{item.data.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>

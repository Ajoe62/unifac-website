---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Surface } from '../types';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  reverse?: boolean;
  surface?: Surface;
  id?: string;
  sizes?: string;
}

const {
  image,
  alt,
  eyebrow,
  title,
  reverse = false,
  surface = 'base',
  id,
  sizes = '(max-width: 820px) 92vw, 46vw',
} = Astro.props;
---
<section id={id} class={['mediatext', reverse ? 'reverse' : null, surface !== 'base' ? `surface-${surface}` : null].filter(Boolean).join(' ')}>
  <div class="wrap mt-grid">
    <div class="mt-media">
      <Image src={image} alt={alt} widths={[480, 768, 1100]} sizes={sizes} format="webp" quality={74} loading="lazy" />
    </div>
    <div class="mt-body">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <div class="mt-copy"><slot /></div>
    </div>
  </div>
</section>

---
/**
 * The icon set, named once.
 *
 * These were 40 inline <svg> blocks pasted across 9 files, 14 of them
 * duplicates of another one somewhere else. That is survivable in a single
 * site and not in a template: content is about to move into Markdown, and a
 * school writing `icon: flask` in a frontmatter block cannot paste a path
 * definition. The registry is what makes an icon nameable.
 *
 * All of them share one grammar, which is why they read as a set: a 24x24
 * box, no fill, round caps, and a stroke the caller sizes. Adding one that
 * breaks that grammar will look like a sticker on the page, so match it.
 */

export type IconName = keyof typeof ICONS;

const ICONS = {
  /* place and direction */
  'map-pin': '<path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  'route-home': '<path d="M4 20V9l8-5 8 5v11"/><path d="M4 20h16"/><path d="m9 20 0-5h6v5"/>',

  /* facilities */
  flask: '<path d="M9 2v6.2L3.8 17A2 2 0 0 0 5.5 20h13a2 2 0 0 0 1.7-3L15 8.2V2"/><path d="M8 2h8"/><path d="M6.4 14h11.2"/>',
  computer: '<rect x="2.5" y="4" width="19" height="12.5" rx="2"/><path d="M8 20h8"/><path d="M12 16.5V20"/><path d="m9.5 8.5-2 1.7 2 1.8"/><path d="m14.5 8.5 2 1.7-2 1.8"/>',
  music: '<path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3Z"/>',
  ball: '<circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 0 0 18M12 3a15 15 0 0 1 0 18M3 12h18"/>',
  book: '<path d="M4 19V5a2 2 0 0 1 2-2h11a1 1 0 0 1 1 1v13"/><path d="M6 17h12v4H6a2 2 0 0 1 0-4Z"/>',
  palette: '<path d="M12 3a9 9 0 0 0 0 18c1.4 0 2-.9 2-1.8 0-1.5-1.3-1.7-1.3-2.9 0-.9.7-1.5 1.7-1.5H16a5 5 0 0 0 5-5c0-3.7-4-6.8-9-6.8Z"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16" cy="10" r="1"/>',

  /* values */
  'graduation-cap': '<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10v4c0 1.5 2.7 3 6 3s6-1.5 6-3v-4"/><path d="M22 8v5"/>',
  flame: '<path d="M12 2c1.5 3-1.5 4-1.5 6.5A2.5 2.5 0 0 0 14 8c1 2.5 0 4-2 5.5"/><path d="M8 13c-1 3 1 6 4 6s5-3 4-6"/><path d="M9 22h6"/>',
  tree: '<path d="M12 22V9"/><path d="M12 13c3.5 0 6-2 6-5.5C18 4 12 2 12 2S6 4 6 7.5C6 11 8.5 13 12 13Z"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z"/>',

  /* people and pastoral */
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M18 20a6 6 0 0 0-3-5.2"/>',
  'shield-check': '<path d="M12 2 3 7v6c0 5 3.5 8 9 9 5.5-1 9-4 9-9V7l-9-5Z"/><path d="m9 12 2 2 4-4"/>',
  eye: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',

  /* contact */
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.6 2.6.7A2 2 0 0 1 22 16.9Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',

  /* software and portal */
  mobile: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18.5h2"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  'clipboard-check': '<path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z"/><path d="M8 5H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><path d="m9 13 2 2 4-4"/>',
  'book-open': '<path d="M12 7c-1.8-1.3-4-2-6.5-2H3v13h2.5c2.5 0 4.7.7 6.5 2 1.8-1.3 4-2 6.5-2H21V5h-2.5C16 5 13.8 5.7 12 7Z"/><path d="M12 7v13"/>',
  mortarboard: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  pencil: '<path d="M4 21v-3.5L15.5 6a2.1 2.1 0 0 1 3 3L7 20.5 3.5 21Z"/><path d="M14 7.5 17.5 11"/>',
  dashboard: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  document: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
} as const;

interface Props {
  name: IconName | string;
  size?: number;
  stroke?: number;
}

const { name, size = 26, stroke = 1.6 } = Astro.props;

const paths = ICONS[name as IconName];
// A content file naming an icon that does not exist should say so during the
// build, not render an empty box that nobody notices until it is live.
if (!paths) {
  throw new Error(
    `Unknown icon "${name}". Available: ${Object.keys(ICONS).sort().join(', ')}`,
  );
}
---
<svg viewBox="0 0 24 24" width={size} fill="none" stroke="currentColor" stroke-width={stroke} set:html={paths} />
